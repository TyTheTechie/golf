generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  username      String?   @unique
  email         String    @unique
  emailVerified DateTime?
  password      String?
  role          String    @default("user") // "user" | "admin"
  image         String?
  phone         String?
  smsOptIn      Boolean   @default(false)
  accounts      Account[]
  sessions      Session[]
  bids          Bid[]
  favorites     AuctionFavorite[]
  captainOf     GolferRegistration[] @relation("teamCaptain")
  joinRequests  TeamJoinRequest[]
  raffleTickets RaffleTicket[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model GolferRegistration {
  id                  String   @id @default(cuid())
  type                String   // "individual" | "team"
  teamName            String?
  inviteCode          String?  @unique
  captainUserId       String?
  captain             User?    @relation("teamCaptain", fields: [captainUserId], references: [id])
  openForJoinRequests Boolean  @default(false)
  player1Name         String
  player1Email        String
  player1Phone        String?
  player2Name         String?
  player2Email        String?
  player2Phone        String?
  player3Name         String?
  player3Email        String?
  player3Phone        String?
  player4Name         String?
  player4Email        String?
  player4Phone        String?
  amount              Int      // in cents
  paymentId           String?  // Square payment ID
  paymentStatus       String   @default("pending") // "pending" | "completed" | "failed"
  checkedIn           Boolean  @default(false)
  checkedInAt         DateTime?
  promoCodeId         String?
  promoCode           PromoCode? @relation(fields: [promoCodeId], references: [id])
  discountAmount      Int      @default(0)
  eventId             String?
  event               Event?   @relation(fields: [eventId], references: [id])
  joinRequests        TeamJoinRequest[]
  scores              Score[]
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model TeamJoinRequest {
  id              String   @id @default(cuid())
  registrationId  String
  registration    GolferRegistration @relation(fields: [registrationId], references: [id])
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  status          String   @default("pending") // "pending" | "approved" | "rejected"
  playerName      String
  playerEmail     String
  playerPhone     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([registrationId])
  @@index([userId])
}

model SponsorRegistration {
  id              String   @id @default(cuid())
  companyName     String
  contactName     String
  contactEmail    String
  contactPhone    String?
  tier            String   // "platinum" | "gold" | "silver" | "bronze" | "hole"
  logoUrl         String?
  amount          Int      // in cents
  paymentId       String?  // Square payment ID
  paymentStatus   String   @default("pending")
  eventId         String?
  event           Event?   @relation(fields: [eventId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model AuctionItem {
  id           String   @id @default(cuid())
  title        String
  description  String
  imageUrl     String?
  startingBid  Int      // in cents
  currentBid   Int      @default(0) // in cents
  bidIncrement Int      @default(500) // in cents, default $5
  status       String   @default("draft") // "draft" | "active" | "completed" | "cancelled"
  endTime      DateTime?
  winnerId     String?
  eventId      String?
  event        Event?   @relation(fields: [eventId], references: [id])
  bids         Bid[]
  favorites    AuctionFavorite[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Bid {
  id            String      @id @default(cuid())
  amount        Int         // in cents
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  auctionItemId String
  auctionItem   AuctionItem @relation(fields: [auctionItemId], references: [id])
  createdAt     DateTime    @default(now())

  @@index([auctionItemId])
  @@index([userId])
}

model AuctionFavorite {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  auctionItemId String
  auctionItem   AuctionItem @relation(fields: [auctionItemId], references: [id])
  createdAt     DateTime    @default(now())

  @@unique([userId, auctionItemId])
  @@index([userId])
}

model Donation {
  id        String   @id @default(cuid())
  name      String
  email     String
  amount    Int      // in cents
  message   String?
  paymentId String?  // Square payment ID
  paymentStatus String @default("pending")
  createdAt DateTime @default(now())
}

model Photo {
  id        String   @id @default(cuid())
  url       String
  caption   String?
  sortOrder Int      @default(0)
  eventId   String?
  event     Event?   @relation(fields: [eventId], references: [id])
  createdAt DateTime @default(now())
}

model PromoCode {
  id          String   @id @default(cuid())
  code        String   @unique
  type        String   // "percentage" | "fixed"
  value       Int      // 0-100 for %, cents for fixed
  maxUses     Int      @default(0) // 0 = unlimited
  currentUses Int      @default(0)
  expiresAt   DateTime?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  usedBy      GolferRegistration[]
}

model WaitlistEntry {
  id         String    @id @default(cuid())
  name       String
  email      String
  phone      String?
  type       String    // "individual" | "team"
  createdAt  DateTime  @default(now())
  notifiedAt DateTime?
}

model Score {
  id             String             @id @default(cuid())
  registrationId String
  registration   GolferRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  hole           Int
  strokes        Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([registrationId, hole])
}

model RaffleTicket {
  id        String       @id @default(cuid())
  number    Int          @unique
  userId    String?
  user      User?        @relation(fields: [userId], references: [id])
  status    String       @default("available") // available | sold | winner
  price     Int          @default(500) // $5
  createdAt DateTime     @default(now())
  wonPrize  RafflePrize?
}

model RafflePrize {
  id          String        @id @default(cuid())
  name        String
  description String
  imageUrl    String?
  ticketId    String?       @unique
  ticket      RaffleTicket? @relation(fields: [ticketId], references: [id])
  createdAt   DateTime      @default(now())
}

model Volunteer {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  roles     String   // JSON array
  shirtSize String?
  notes     String?
  createdAt DateTime @default(now())
}

model Event {
  id            String   @id @default(cuid())
  name          String
  year          Int
  date          DateTime
  venue         String
  description   String
  isActive      Boolean  @default(false)
  createdAt     DateTime @default(now())
  results       EventResult[]
  photos        Photo[]
  registrations GolferRegistration[]
  sponsors      SponsorRegistration[]
  auctionItems  AuctionItem[]
}

model EventResult {
  id          String   @id @default(cuid())
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  place       Int
  teamName    String
  playerNames String
  score       Int
  createdAt   DateTime @default(now())
}
